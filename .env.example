# 选择一种兼容 OpenAI Chat Completions 的模型服务，填入对应 API Key。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Local hybrid retrieval models. They download automatically on first use.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Maximum model → tool → model turns for one chat request.
AGENT_MAX_TOOL_STEPS=4
MAX_UPLOAD_BYTES=20971520
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Retrieval quality controls. Query rewriting falls back to the original question on failure.
QUERY_REWRITE_ENABLED=1
# Optional: use a smaller/cheaper compatible model just for query rewrite.
QUERY_REWRITE_MODEL=
RAG_DYNAMIC_MIN_K=2
RAG_DYNAMIC_MAX_K=8
RAG_DYNAMIC_DROP_THRESHOLD=0.25

# Optional API protection. Leave empty for local development; use a long random value in deployment.
KNOWLEDGEPILOT_API_KEYS=
CHAT_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=120
